
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "forgex",
  "main": "worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/dl/*",
      "/media/*"
    ]
  },
  "vars": {
    "OWNER_EMAIL": "king2014mortada@gmail.com",
    "MAX_FILE_MB": "95"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "forgex-db",
      "database_id": "REPLACE_WITH_D1_ID",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "forgex-files"
    }
  ],
  "triggers": {
    "crons": [
      "0 3 * * *"
    ]
  }
}
